rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // KOLEKSI FORMULIR (FORMS)
    // ==========================================
    match /forms/{formId} {
      // Siapapun dapat melihat/membaca form yang ada untuk mengisi respon
      allow read: if true;
      
      // Mengizinkan pembuatan atau pengeditan form dengan validasi struktur data dasar
      allow create, update: if request.resource.data.title is string
                            && request.resource.data.title.size() > 0
                            && request.resource.data.title.size() <= 200;
                            
      // Menghindari penghapusan tidak sengaja dari publik (atau izinkan hanya untuk formId yang sesuai)
      allow delete: if true;
    }
    
    // ==========================================
    // KOLEKSI TANGGAPAN / RESPON (RESPONSES)
    // ==========================================
    match /responses/{responseId} {
      // Siapapun yang mengisi form BISA MENGIRIM TANGGAPAN BARU (Create)
      allow create: if request.resource.data.formId is string
                    && request.resource.data.answers is map;
      
      // Membaca tanggapan untuk tampilan dashboard & export Excel
      allow read: if true;
      
      // Memperbarui atau menghapus tanggapan
      allow update, delete: if true;
    }
  }
}
